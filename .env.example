# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth Configuration:
# NO agregues Client ID/Secret aquí - van en Supabase Dashboard
# 1. Ve a: https://supabase.com/dashboard → Tu Proyecto
# 2. Authentication → Providers → Google → Enable
# 3. Agrega Client ID y Secret desde Google Cloud Console
# 4. Ver guía completa en: GOOGLE_OAUTH_QUICK_FIX.md

# Chatbot API (optional: if empty, assistant works in local fallback mode)
VITE_CHATBOT_API_URL=
VITE_CHATBOT_API_KEY=

# Optional payment and shipping integration endpoints (frontend -> your backend)
VITE_CHECKOUT_API_URL=
VITE_SHIPPING_RATES_API_URL=
